  "plans": {
    "q01": {
      "query": "/* select#1 */ select `a`.`appointment_id` AS `appointment_id`,`p`.`full_name` AS `patient_name`,`d`.`full_name` AS `doctor_name`,coalesce(`sp`.`specialty_name`,'General Practitioner') AS `specialty_name`,`a`.`appointment_date_time` AS `appointment_date_time`,`ds`.`start_time` AS `start_time`,`ds`.`end_time` AS `end_time`,`a`.`status` AS `status` from `healthcare_clinic_portal`.`appointment` `a` join `healthcare_clinic_portal`.`patient` `p` join `healthcare_clinic_portal`.`doctor` `d` join `healthcare_clinic_portal`.`doctor_schedule` `ds` left join `healthcare_clinic_portal`.`specialist` `st` on((`st`.`doctor_id` = `d`.`doctor_id`)) left join `healthcare_clinic_portal`.`specialty` `sp` on((`sp`.`specialty_id` = `st`.`specialty_id`)) where ((`p`.`patient_id` = `a`.`patient_id`) and (`a`.`doctor_id` = `d`.`doctor_id`) and (`ds`.`schedule_id` = `a`.`schedule_id`) and (cast(`a`.`appointment_date_time` as date) = <cache>((@`report_date`)))) order by `a`.`appointment_date_time`",
